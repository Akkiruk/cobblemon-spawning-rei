{
  "schemaVersion": 1,
  "id": "cobbledex-rei-emi-jei",
  "version": "${version}",
  "name": "CobbleDex REI/EMI/JEI",
  "description": "Your complete Cobblemon Pokédex in REI, JEI, or EMI. Browse spawn locations, evolution chains, base stats, item drops, Pokédex info, and special obtainment methods for every Pokémon — all from your recipe viewer.",
  "authors": ["Akkiruk"],
  "contact": {
    "homepage": "https://github.com/Akkiruk/cobblemon-spawning-rei",
    "sources": "https://github.com/Akkiruk/cobblemon-spawning-rei",
    "issues": "https://github.com/Akkiruk/cobblemon-spawning-rei/issues"
  },
  "license": "MIT",
  "icon": "assets/cobbledex-rei-emi-jei/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.cobbledex.fabric.CobbleDexFabricClient"
      }
    ],
    "rei_client": [
      {
        "adapter": "kotlin",
        "value": "com.cobbledex.rei.CobbleDexREIPlugin"
      }
    ],
    "jei_mod_plugin": [
      {
        "adapter": "kotlin",
        "value": "com.cobbledex.jei.CobbleDexJEIPlugin"
      }
    ],
    "emi": [
      {
        "adapter": "kotlin",
        "value": "com.cobbledex.emi.CobbleDexEMIPlugin"
      }
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21 <1.22",
    "cobblemon": ">=1.7.1",
    "fabric-language-kotlin": ">=1.13.4",
    "fabric-api": "*"
  },
  "suggests": {
    "roughlyenoughitems": "*",
    "jei": "*",
    "emi": "*"
  },
  "breaks": {
    "cobblemon": "<1.7.1"
  }
}
